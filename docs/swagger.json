    "definitions": {
        "ds.Composer": {
            "type": "object",
            "properties": {
                "creator_id": {
                    "type": "integer"
                },
                "current_user_is_creator": {
                    "type": "boolean"
                },
                "date_create": {
                    "type": "string"
                },
                "date_formed": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "freq1": {
                    "type": "number"
                },
                "freq2": {
                    "type": "number"
                },
                "id": {
                    "type": "integer"
                },
                "image_url": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "video_url": {
                    "type": "string"
                }
            }
        },
        "handler.loginReq": {
            "type": "object",
            "required": [
                "login",
                "password"
            ],
            "properties": {
                "login": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "handler.registerReq": {
            "type": "object",
            "required": [
                "login",
                "password"
            ],
            "properties": {
                "login": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        }
    },

{
    "swagger": "2.0",
    "info": {
        "description": "Backend API for Composers SPA (LR4)",
        "title": "Composers API",
        "contact": {},
        "version": "1.0"
    },
    "host": "127.0.0.1:8080",
    "basePath": "/api",
    "paths": {
        "/composer": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "composers"
                ],
                "summary": "Создание черновика композитора",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Имя композитора",
                        "name": "name",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "Изображение",
                        "name": "pic",
                        "in": "formData"
                    },
                    {
                        "type": "file",
                        "description": "Видео",
                        "name": "video",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/ds.Composer"
                        }
                    }
                }
            }
        },
        "/composer/draft": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "composers"
                ],
                "summary": "Получение черновика композитора",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ds.Composer"
                        }
                    }
                }
            }
        },
        "/composer/feed": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "composers"
                ],
                "summary": "Получение ленты композиторов",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Текущий ID",
                        "name": "id",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Запрос далее",
                        "name": "next",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ds.Composer"
                        }
                    }
                }
            }
        },
        "/composer/{id}": {
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "composers"
                ],
                "summary": "Удаление композитора",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID композитора",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/composer/{id}/like": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "consumes": [
                    "multipart/form-data"
                ],
                "tags": [
                    "composers"
                ],
                "summary": "Лайк/Дизлайк композитора",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID композитора",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Значение лайка",
                        "name": "like",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/composer/{id}/publish": {
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "consumes": [
                    "multipart/form-data"
                ],
                "tags": [
                    "composers"
                ],
                "summary": "Публикация черновика композитора",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID композитора",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Описание",
                        "name": "description",
                        "in": "formData"
                    },
                    {
                        "type": "number",
                        "description": "Частота 1",
                        "name": "freq1",
                        "in": "formData"
                    },
                    {
                        "type": "number",
                        "description": "Частота 2",
                        "name": "freq2",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/composers": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "composers"
                ],
                "summary": "Получение списка опубликованных композиторов",
                "parameters": [
                    {
                        "type": "number",
                        "description": "Минимальная частота",
                        "name": "min_freq",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Максимальная частота",
                        "name": "max_freq",
                        "in": "query"
                    }
